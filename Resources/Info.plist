<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sleep Sheep</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect to your Sleep Sheep to adjust its light and record head pats.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Read your calendar commitments to help plan your sleep and wake-up routine.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Read your sleep and heart rate to summarize your latest night of sleep on this device.</string>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
