# Copy to .env (git-ignored). Everything is optional: with no .env, Drift runs on the backup rules,
# looks for the sheep on USB, and uses live Open-Meteo weather.
# Credentials and device addresses stay on the server and are never sent to the browser.

PORT=3000
# 127.0.0.1 = this laptop only. 0.0.0.0 lets a phone on the same Wi-Fi reach it (no login: trusted networks only).
HOST=127.0.0.1
# DATA_DIR=data

# ---- LLM agent (Claude) ----
# With a key, the agent decides the light and sound on events; without one, backup rules run.
# ANTHROPIC_API_KEY=sk-ant-...
# DRIFT_AGENT=off                      # force the backup rules even with a key
DRIFT_AGENT_MODEL=claude-opus-5-5
DRIFT_AGENT_EFFORT=medium              # low | medium | high | xhigh | max
DRIFT_AGENT_MAX_RUNS_PER_HOUR=20       # cost cap; "Run agent now" counts too

# ---- Sleep Sheep hardware ----
# USB goes through hardware_integration/bridge.py -> sheep.py (needs Python 3 + pyserial).
# Bluetooth is connected from the dashboard in Chrome/Edge (or Bluefy on iPhone).
SHEEP_TRANSPORT=auto                   # auto (USB, then Bluetooth) | usb | ble | sim
SHEEP_USB=on                           # off = don't open the serial port (e.g. Arduino IDE needs it)
# SHEEP_PORT=COM9                      # default: auto-detect the Arduino
# SHEEP_PYTHON=python                  # python / python3 / py
SHEEP_SIMULATE=0                       # 1 = add a labeled simulated sheep (for working without hardware)
DEMO_SPEEDUP=1                         # 60 on stage: a 30-minute sunrise plays in 30 seconds

# ---- Light ----
LIGHT_ADAPTER=sheep                    # sheep | simulated | hue | http
# HUE_BRIDGE_IP=192.168.1.20
# HUE_USERNAME=your-bridge-username
# HUE_LIGHT_ID=1
# LIGHT_URL=http://192.168.1.50/light
LIGHT_COLOR_TEMP=true

# ---- Sound ----
AUDIO_ADAPTER=browser                  # browser (the dashboard tab plays it after Enable Sound) | simulated | http
# AUDIO_URL=http://192.168.1.50/audio
FAN_ADAPTER=none                       # none | simulated | http
# FAN_URL=http://192.168.1.50/fan

# ---- Weather ----
WEATHER_PROVIDER=open-meteo            # open-meteo (live, free, no key) | scenario (offline, labeled simulated)
WEATHER_SCENARIO=rain                  # rain | thunderstorm | clear-evening | strong-wind | missing | cloudy | stale
WEATHER_TIMEOUT_MS=6000
WEATHER_RETRIES=2
WEATHER_REFRESH_MIN=30
WEATHER_STALE_AFTER_MIN=180
WIND_STRONG_SPEED_KMH=40               # engineering choice, not a provider value
WIND_STRONG_GUST_KMH=60

TICK_MS=2000
SEED_SAMPLE_USERS=true
